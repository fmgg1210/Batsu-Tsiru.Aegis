// LEDS MQ135
int mqR = 9;
int mqG = 10;
int mqB = 11;

// LEDS MQ-7 (antes LDR)
int coR = 12;
int coG = 13;
int coB = 44;

// MQ135
int mq135 = A0;

// MQ-7
int mq7 = A1;

