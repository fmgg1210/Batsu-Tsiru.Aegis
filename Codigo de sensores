void setup()
{
  Serial.begin(9600);
  Serial1.begin(115200);

  dht.begin();

  pinMode(tempR, OUTPUT);
  pinMode(tempG, OUTPUT);
  pinMode(tempB, OUTPUT);

  pinMode(humR, OUTPUT);
  pinMode(humG, OUTPUT);
  pinMode(humB, OUTPUT);

  pinMode(mqR, OUTPUT);
  pinMode(mqG, OUTPUT);
  pinMode(mqB, OUTPUT);

  pinMode(coR, OUTPUT);
  pinMode(coG, OUTPUT);
  pinMode(coB, OUTPUT);

  // Prueba de LEDs al arrancar
  setRGB(tempR, tempG, tempB, 255, 0, 0);
  setRGB(humR, humG, humB, 0, 255, 0);
  setRGB(mqR, mqG, mqB, 0, 0, 255);
  setRGB(coR, coG, coB, 255, 255, 255);

  delay(3000);
}

